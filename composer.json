{
    "name": "panchodp/laravel-actions",
    "description": "Make your Laravel actions classes fast and in a simple way.",
    "keywords": ["dev","php","command","laravel", "actions"],
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Panchodp\\LaravelAction\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Panchodp\\LaravelAction\\Test\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Panchodp\\LaravelAction\\LaravelActionServiceProvider"
            ]
        },
        "composer-require-dev": true
    },
    "authors": [
        {
            "name": "Francisco de Pablo",
            "email": "fcodepablo@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "laravel/pint": "^1.30.4",
        "larastan/larastan": "^3.10.0",
        "pestphp/pest": "^5.0.4",
        "rector/rector": "^2.6.1"
    },
    "scripts": {
        "test": [
            "./vendor/bin/pest"
        ],
        "pint": [
            "./vendor/bin/pint"
        ],
        "pint:test": [
            "./vendor/bin/pint --test"
        ],
        "analyse": [
            "./vendor/bin/phpstan analyse"
        ],
        "dry": ["vendor/bin/rector process --dry-run --ansi"],
        "test:all": [
            "@test","@pint","@analyse","@dry"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
